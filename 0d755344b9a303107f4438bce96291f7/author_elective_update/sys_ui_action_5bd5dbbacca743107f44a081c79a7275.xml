        <name>Manager decline</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[function managerDecline() {
    var reason = prompt('Why are you declining this sign-off? This is required.');
    if (reason === null) { return; }
    reason = reason.trim();
    if (!reason) { alert('Please type a reason.'); return; }
    var ga = new GlideAjax('x_snc_insurance_0.IRISRequestInfo');
    ga.addParam('sysparm_name', 'managerDecline');
    ga.addParam('sysparm_claim', g_form.getUniqueValue());
    ga.addParam('sysparm_message', reason);
    ga.getXMLAnswer(function(answer) {
        if (answer === 'ok') {
            window.location.reload();
        } else {
            alert('Could not decline: ' + answer);
        }
    });
}

managerDecline();]]></script>
