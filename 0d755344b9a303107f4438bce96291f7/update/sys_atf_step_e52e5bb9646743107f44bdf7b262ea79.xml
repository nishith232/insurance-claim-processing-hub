        <value>var claim = new GlideRecord('x_snc_insurance_0_claim');&#13;
claim.initialize();&#13;
claim.setValue('claim_type', 'motor');&#13;
claim.setValue('claim_amount_requested', 76000);&#13;
&#13;
new SettlementRecommender().evaluate(claim);&#13;
&#13;
var recommendation = claim.getValue('settlement_recommendation');&#13;
var references = claim.getValue('settlement_reference_claims');&#13;
&#13;
// Assertions&#13;
if (!recommendation || recommendation.indexOf('Rs.') == -1) {&#13;
    throw new Error('Expected a settlement range starting with "Rs.", got: ' + recommendation);&#13;
}&#13;
if (!references || references.indexOf('HIST-') == -1) {&#13;
    throw new Error('Expected reference claims containing "HIST-", got: ' + references);&#13;
}&#13;
if ((references.match(/HIST-/g) || []).length != 3) {&#13;
    throw new Error('Expected exactly 3 reference claims, got: ' + references);&#13;
}&#13;
&#13;
gs.info('PASS: ' + recommendation + ' | ' + references);</value>
