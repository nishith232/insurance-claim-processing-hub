        <name>Auto-fill Policy Number</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onLoad() {
    var userId = g_user.userID;
    var url = '/api/now/table/x_snc_insurance_0_policy?sysparm_query=policy_owner=' + userId + '&sysparm_limit=1&sysparm_fields=sys_id,policy_number';
    
    fetch(url, {
        credentials: 'same-origin',
        headers: {
            'Accept': 'application/json'
        }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        console.log('REST response: ' + JSON.stringify(data));
        if (data.result && data.result.length > 0) {
            var policy = data.result[0];
            g_form.setValue('policy_number', policy.sys_id, policy.policy_number);
        }
    })
    .catch(function(e) {
        console.log('Error: ' + e);
    });
}]]></script>
