        <name>Assign to me</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function() {
    current.setValue('assigned_adjuster', gs.getUserID());
    current.setValue('assigned_date', new GlideDateTime().getValue());
    current.update();

    // Also assign the linked case, so it shows in this adjuster's own list
    var cs = new GlideRecord('sn_customerservice_case');
    if (current.customer_case && cs.get(current.getValue('customer_case'))) {
        cs.setValue('assigned_to', gs.getUserID());
        cs.update();
    }

    gs.addInfoMessage('Claim assigned to you.');
    action.setRedirectURL(current);
})();]]></script>
