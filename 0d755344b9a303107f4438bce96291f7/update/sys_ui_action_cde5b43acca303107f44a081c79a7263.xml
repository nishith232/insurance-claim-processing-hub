        <name>Finalize and notify customer</name>
        <onclick>finalizeClaim()</onclick>
        <order>100</order>
        <script><![CDATA[function finalizeClaim() {
    var status = g_form.getValue('claim_status');
    var amount = g_form.getValue('approved_amount');
    var claimNumber = g_form.getValue('number');
    var defaultMsg = '';

    if (status == 'approval' && amount) {
        var formatted = parseFloat(amount).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        defaultMsg = 'Your claim ' + claimNumber + ' has been approved for Rs. ' + formatted + '. ';
    }

    var msg = prompt('Write the message the customer will see. Review and edit as needed before sending:', defaultMsg);
    if (msg === null) { return false; }
    msg = msg.trim();
    if (!msg) { alert('Please write a message before sending.'); return false; }

    var ga = new GlideAjax('x_snc_insurance_0.IRISRequestInfo');
    ga.addParam('sysparm_name', 'finalize');
    ga.addParam('sysparm_claim', g_form.getUniqueValue());
    ga.addParam('sysparm_message', msg);
    ga.getXMLAnswer(function(answer) {
        if (answer === 'ok') {
            window.location.reload();
        } else {
            alert('Could not finalize: ' + answer);
        }
    });
    return false;
}]]></script>
