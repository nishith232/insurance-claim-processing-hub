        <script><![CDATA[(function executeRule(current, previous) {
    // Don't reopen a claim that is already at approval or closed
    var st = current.getValue('claim_status');
    if (st == 'approval' || st == 'rejected' || st == 'closed') {
        return;
    }

    current.setValue('claim_status', 'adjuster_review');

    // Tell the customer, in plain words only (no scores, no AI findings)
    var cs = new GlideRecord('sn_customerservice_case');
    if (current.getValue('customer_case') && cs.get(current.getValue('customer_case'))) {
        var name = current.assigned_adjuster.getDisplayValue();
        cs.comments = 'Your claim is now being reviewed by ' + name + '.';
        cs.update();
    }
})(current, previous);]]></script>
