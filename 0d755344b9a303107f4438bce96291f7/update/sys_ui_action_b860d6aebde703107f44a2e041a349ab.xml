        <name>Recommend approval</name>
        <onclick>askForApproval()</onclick>
        <order>100</order>
        <script><![CDATA[function askForApproval() {
    var amount = prompt('Approved amount (INR)? The AI suggested settlement range is shown on the form for guidance only.');
    if (amount === null) { return false; }
    amount = amount.trim();
    if (!amount || isNaN(parseFloat(amount)) || parseFloat(amount) <= 0) {
        alert('Please enter a valid positive amount.'); return false;
    }
    var note = prompt('Optional note about this approval (internal only, the customer will not see this):') || '';
    var ga = new GlideAjax('x_snc_insurance_0.IRISRequestInfo');
    ga.addParam('sysparm_name', 'approve');
    ga.addParam('sysparm_claim', g_form.getUniqueValue());
    ga.addParam('sysparm_amount', amount);
    ga.addParam('sysparm_message', note.trim());
    ga.getXMLAnswer(function(answer) {
        if (answer === 'ok') {
            window.location.reload();
        } else {
            alert('Could not record: ' + answer);
        }
    });
    return false;
}]]></script>
